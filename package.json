{
  "name": "gantt-chart-component",
  "version": "0.1.0",
  "description": "A TypeScript + React Gantt chart. Data in, chart out.",
  "license": "MIT",
  "author": "Darrenfisherlol",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.4.0"
  },
  "keywords": [
    "react",
    "gantt",
    "gantt-chart",
    "chart",
    "timeline",
    "typescript",
    "component"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Darrenfisherlol/gantt-chart-component.git"
  },
  "bugs": {
    "url": "https://github.com/Darrenfisherlol/gantt-chart-component/issues"
  },
  "homepage": "https://github.com/Darrenfisherlol/gantt-chart-component#readme"
}
